{
  "info": {
    "name": "Razorpay Playground",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Go backend for testing every Razorpay flow in test mode. Run requests top to bottom; IDs are saved into collection variables automatically."
  },
