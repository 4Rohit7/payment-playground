    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Simulate signed webhook (payment.captured)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhooks/razorpay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "razorpay"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"entity\":\"event\",\"account_id\":\"acc_test\",\"event\":\"payment.captured\",\"contains\":[\"payment\"],\"payload\":{\"payment\":{\"entity\":{\"id\":\"{{paymentId}}\",\"entity\":\"payment\",\"amount\":50000,\"currency\":\"INR\",\"status\":\"captured\",\"order_id\":\"{{orderId}}\",\"method\":\"upi\",\"captured\":true,\"vpa\":\"success@razorpay\",\"notes\":[]}}},\"created_at\":1700000000}"
            },
            "description": "Set webhookSecret to your RAZORPAY_WEBHOOK_SECRET first. Real webhooks come from Razorpay through your tunnel."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Signs the body exactly like Razorpay does, using the webhookSecret collection variable.",
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "const sig = CryptoJS.HmacSHA256(body, pm.collectionVariables.get('webhookSecret')).toString(CryptoJS.enc.Hex);",
                  "pm.request.body.raw = body;",
                  "pm.request.headers.upsert({ key: 'X-Razorpay-Signature', value: sig });",
                  "pm.request.headers.upsert({ key: 'X-Razorpay-Event-Id', value: 'evt_postman_' + Date.now() });"
                ]
              }
            }
          ]
        }
      ]
    },
