# Server
PORT=8080
# Used to build callback URLs (payment links). Set to your ngrok/cloudflared URL when testing webhooks.
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated origins allowed to call the API (your future frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MERCHANT_NAME=Razorpay Playground

# Postgres (same DB you see in pgAdmin)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/razorpay_playground?sslmode=disable

# Razorpay TEST credentials (Dashboard > Test mode > Account & Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# The secret you type when creating the webhook in the dashboard (not the API secret)
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_string

# Safety: the server refuses to start with live keys unless this is true
ALLOW_LIVE_KEYS=false
